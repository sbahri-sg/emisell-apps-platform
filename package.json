{
  "name": "emisell-app-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "example:shipping:test": "cd examples/shipping-rate-provider && go test -race ./...",
    "sync:extension-catalog": "node scripts/sync-extension-catalog.mjs",
    "sync:shipping-contract": "node scripts/sync-shipping-provider-contract.mjs",
    "sync:shipping-rate-bridge": "node scripts/sync-shipping-rate-bridge.mjs",
    "example:lab": "node scripts/product-reader-lab.mjs",
    "example:check": "node scripts/product-reader-lab.mjs --check",
    "example:test": "cd examples/product-reader && go test -race ./...",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "sync:product-contracts": "node scripts/sync-product-contracts.mjs",
    "sync:resource-blueprint": "node scripts/sync-resource-blueprint.mjs",
    "sync:billing-contracts": "node scripts/sync-billing-contracts.mjs",
    "validate:contracts": "node scripts/sync-extension-catalog.mjs --check && node scripts/sync-shipping-provider-contract.mjs --check && node scripts/sync-shipping-rate-bridge.mjs --check && node scripts/sync-resource-blueprint.mjs --check && node scripts/sync-product-contracts.mjs --check && node scripts/sync-billing-contracts.mjs --check && node scripts/sync-integration-contracts.mjs --check && node scripts/sync-admin-login-contracts.mjs --check && node scripts/validate-openapi.mjs",
    "sync:admin-login-contracts": "node scripts/sync-admin-login-contracts.mjs",
    "sync:integration-contracts": "node scripts/sync-integration-contracts.mjs",
    "test:integration-readiness": "node scripts/test-integration-readiness.mjs",
    "test:admin-login": "node scripts/test-integration-readiness.mjs --admin-login",
    "test:docs": "node --test scripts/documentation.test.mjs scripts/developer-documentation.test.mjs scripts/session-routing.test.mjs",
    "test:extensions": "node scripts/test-extension-connections.mjs",
    "test:billing": "node scripts/test-app-billing.mjs",
    "backend:run": "cd services/app-gateway && go run ./cmd/server",
    "backend:test": "cd services/app-gateway && go test ./...",
    "backend:check": "cd services/app-gateway && go vet ./... && go test -race ./...",
    "backend:integration": "cd services/app-gateway && TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://emisell:emisell-dev@localhost:55433/emisell_app_platform?sslmode=disable} go test -count=1 ./internal/adapters/postgres",
    "docker:up": "docker compose up --build -d --wait --wait-timeout 120",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:prod:config": "docker compose --env-file deploy/production.env -f compose.production.yaml config -q",
    "docker:prod:build": "docker compose --env-file deploy/production.env -f compose.production.yaml build",
    "docker:prod:up": "docker compose --env-file deploy/production.env -f compose.production.yaml up --build -d --wait --wait-timeout 180",
    "docker:prod:down": "docker compose --env-file deploy/production.env -f compose.production.yaml down",
    "docker:prod:logs": "docker compose --env-file deploy/production.env -f compose.production.yaml logs -f",
    "db:migrate": "docker compose run --rm migrate",
    "db:shell": "docker compose exec postgres sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "check": "npm run validate:contracts && npm run test:docs && npm run typecheck && npm run lint && npm run backend:check && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "next": "^16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
