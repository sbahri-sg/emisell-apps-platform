APP_ENV=development
HTTP_ADDRESS=:8080
SHUTDOWN_TIMEOUT=10s
CORS_ALLOWED_ORIGINS=http://localhost:3003
REPOSITORY_DRIVER=postgres
DATABASE_URL=postgres://emisell:emisell-dev@localhost:55433/emisell_app_platform?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT=5s
DEVELOPMENT_BEARER_TOKEN=emisell-local-dev-token
DEVELOPMENT_ORGANIZATION_ID=01995f72-0000-7000-8000-000000000001
DEVELOPMENT_USER_ID=01995f72-0000-7000-8000-000000000002
DEVELOPMENT_ROLE=owner
DEVELOPMENT_EMAIL=developer@local.emisell.test
DEVELOPMENT_DISPLAY_NAME=Emisell Platform Operator
DEVELOPMENT_PLATFORM_OPERATOR=true
DEVELOPER_INVITATION_TTL=48h
SECRET_ENCRYPTION_KEY_BASE64=r8PQPmYOmajyNIx3Gn4bEISAPze1pvrCs8vB/WOjjjc=
SECRET_ENCRYPTION_KEY_VERSION=1
# Default-off; does not execute Payment or Shipping runtimes.
EXTENSION_CONNECTIONS_ENABLED=false
OAUTH_CODE_TTL=5m
OAUTH_ACCESS_TOKEN_TTL=1h
WEBHOOK_POLL_INTERVAL=1s
WEBHOOK_REQUEST_TIMEOUT=8s
WEBHOOK_BATCH_SIZE=25
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BASE_RETRY=5s
WEBHOOK_MAX_RETRY=15m

# Required only for APP_ENV=production
# AUTH_JWT_ISSUER=https://identity.example.com
# AUTH_JWT_AUDIENCE=emisell-app-platform
# AUTH_JWT_KEY_ID=production-key-1
# AUTH_JWT_PUBLIC_KEY_BASE64=<base64-encoded RSA public key PEM>
# AUTH_JWT_CLOCK_SKEW=30s

# Optional local test-install pilot; requires a separately configured resource adapter.
# Do not set these in production. Prefer the disposable Product Reader lab.
EMISELL_RESOURCE_TEST_MERCHANT_IDS=
DEVELOPMENT_LOOPBACK_APP_HTTP=false
