# Hosting environment only. These are NOT loaded by the development .env loader.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
EMISELL_APP_URL=https://app.example.com
EMISELL_DASHBOARD_ORIGIN=https://seller.example.com
EMISELL_TLS_TERMINATION=external
# disabled serves the UI but readiness and store APIs remain unavailable.
# custom requires a real server/production-backend.mjs implementation.
EMISELL_BACKEND_MODE=disabled
