  "components": {
    "securitySchemes": {
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "emisell_admin_session"
      },
      "developerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "emisell_developer_session"
      }
    },
    "schemas": {
      "Config": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol",
          "endpoint",
          "callbackUrl",
          "healthUrl"
        ],
        "properties": {
          "protocol": {
            "const": "emisell.capability-http/v1"
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "callbackUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "healthUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        }
      },
      "Input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "submissionId",
          "config"
        ],
        "properties": {
          "submissionId": {
            "type": "string"
          },
          "config": {
            "$ref": "#/components/schemas/Config"
          }
        }
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "revision",
          "reason"
        ],
        "properties": {
          "status": {
            "enum": [
              "approved",
              "rejected",
              "signed",
              "suspended"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "Manifest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "policy",
          "submissionId",
          "metadata",
          "config"
        ],
        "properties": {
          "schema": {
            "const": "emisell.integration-release/v1"
          },
          "policy": {
            "const": "integration-configuration/v1"
          },
          "submissionId": {
            "type": "string"
          },
          "metadata": {
            "$ref": "catalog.v1.json#/components/schemas/Manifest"
          },
          "config": {
            "$ref": "#/components/schemas/Config"
          }
        }
      },
      "Package": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "sha256",
          "keyId",
          "signature"
        ],
        "properties": {
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "keyId": {
            "type": "string"
          },
          "signature": {
            "type": "string",
            "contentEncoding": "base64"
          }
        }
      },
      "Release": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "organizationId",
          "manifest",
          "sha256",
          "status",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "sha256": {
            "type": "string"
          },
          "package": {
            "$ref": "#/components/schemas/Package"
          },
          "status": {
            "enum": [
              "submitted",
              "approved",
              "rejected",
              "signed",
              "suspended"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Validation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "valid",
          "installable",
          "checks",
          "blockers"
        ],
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "installable": {
            "const": false
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "passed",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Audit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "actorId",
          "action",
          "reason",
          "occurredAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "actorId": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Detail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "release",
          "history",
          "validation",
          "trustedPublicKey"
        ],
        "properties": {
          "release": {
            "$ref": "#/components/schemas/Release"
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Audit"
            }
          },
          "validation": {
            "$ref": "#/components/schemas/Validation"
          },
          "trustedPublicKey": {
            "type": [
              "string",
              "null"
            ],
            "contentEncoding": "base64"
          }
        }
      },
      "Mutation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "release",
          "validation"
        ],
        "properties": {
          "release": {
            "$ref": "#/components/schemas/Release"
          },
          "validation": {
            "$ref": "#/components/schemas/Validation"
          }
        }
      },
      "List": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "releases",
          "limit"
        ],
        "properties": {
          "releases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Release"
            }
          },
          "limit": {
            "const": 200
          }
        }
      },
      "Preview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "validation"
        ],
        "properties": {
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "validation": {
            "$ref": "#/components/schemas/Validation"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
