  "components": {
    "securitySchemes": {
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "emisell_admin_session"
      },
      "developerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "emisell_developer_session"
      }
    },
    "schemas": {
      "Readiness": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configurationReady": {
            "type": "boolean"
          },
          "requiredScopesReady": {
            "type": "boolean"
          },
          "installable": {
            "type": "boolean",
            "description": "True only for the explicitly enabled local managed engine with a signed release and current approved assignment. Never merchant consent or active access."
          },
          "blockers": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "enum": [
                "runtime_not_available",
                "oauth_not_available",
                "endpoint_runtime_unverified",
                "release_not_ready",
                "required_scopes_not_ready",
                "managed_installation_not_available",
                "engine_grant_enforcement_not_available"
              ]
            }
          }
        },
        "required": [
          "configurationReady",
          "requiredScopesReady",
          "installable",
          "blockers"
        ]
      },
      "TestApp": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assignmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "appId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "appName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "capability": {
            "type": "string",
            "enum": [
              "payment/v1",
              "shipping/v1"
            ]
          },
          "readiness": {
            "$ref": "#/components/schemas/Readiness"
          }
        },
        "required": [
          "assignmentId",
          "appId",
          "appName",
          "version",
          "capability",
          "readiness"
        ]
      },
      "Assignment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "releaseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "releaseSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "merchantId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "requested",
              "approved",
              "rejected",
              "revoked"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "releaseKind": {
            "type": "string",
            "enum": [
              "managed_shipping", "ui"
            ],
            "description": "Omit for legacy integration releases. ui selects a signed UI release; UI assignments are not yet installable."
          }
        },
        "required": [
          "id",
          "organizationId",
          "releaseId",
          "releaseSha256",
          "merchantId",
          "status",
          "revision",
          "createdAt",
          "updatedAt"
        ]
      },
      "View": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "releaseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "releaseSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "merchantId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "requested",
              "approved",
              "rejected",
              "revoked"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "app": {
            "$ref": "#/components/schemas/TestApp"
          },
          "releaseKind": {
            "type": "string",
            "enum": [
              "managed_shipping", "ui"
            ],
            "description": "Omit for legacy integration releases. ui selects a signed UI release; UI assignments are not yet installable."
          }
        },
        "required": [
          "id",
          "organizationId",
          "releaseId",
          "releaseSha256",
          "merchantId",
          "status",
          "revision",
          "createdAt",
          "updatedAt",
          "app"
        ]
      },
      "List": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assignments": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/View"
            }
          },
          "nextAfterId": {
            "type": "string"
          }
        },
        "required": [
          "assignments",
          "nextAfterId"
        ]
      },
      "Detail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assignment": {
            "$ref": "#/components/schemas/View"
          },
          "history": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "actorId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "occurredAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "id",
                "actorId",
                "action",
                "reason",
                "occurredAt"
              ]
            }
          }
        },
        "required": [
          "assignment",
          "history"
        ]
      },
      "Mutation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assignment": {
            "$ref": "#/components/schemas/Assignment"
          }
        },
        "required": [
          "assignment"
        ]
      },
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "releaseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "merchantId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "releaseKind": {
            "type": "string",
            "enum": [
              "managed_shipping", "ui"
            ],
            "description": "Omit for legacy integration releases. ui selects a signed UI release; UI assignments are not yet installable."
          }
        },
        "required": [
          "releaseId",
          "merchantId",
          "reason"
        ]
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "revoked"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "status",
          "revision",
          "reason"
        ]
      }
    }
  }
}
