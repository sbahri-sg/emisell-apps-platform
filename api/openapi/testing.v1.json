{
  "openapi": "3.1.0",
  "info": {
    "title": "Emisell Test Distribution API",
    "version": "1.0.0",
    "description": "Metadata distribusi aplikasi uji. Tidak merupakan installation authority. ADR 0022: authoring/distribusi baru hanya shipping/v1. Payment gateway checkout internal Emisell, bukan aplikasi umum. Record payment historis tetap terbaca; reject/suspend/revoke tersedia. Pengajuan/approval/sign/publish dan kesiapan app-client/Testing payment ditolak. Instalasi/RPC payment fixture tidak diubah."
  },
  "servers": [
    {
      "url": "http://localhost:8087"
    }
  ],
  "paths": {
    "/api/v1/admin/test-assignments": {
      "get": {
        "summary": "Daftar assignment pengujian",
        "description": "ADR 0021/0026. Cookie dan Origin sesuai surface wajib. Developer hanya organisasinya; Admin membaca, administrator memutuskan dan memvalidasi merchant terdaftar. Sumber default integration; releaseKind=managed_shipping memilih release provider terkelola tanpa OAuth fiktif. Request baru/approval memverifikasi signature, checksum dan ownership. Snapshot/revision/idempotency/audit immutable; retry identik membaca state terkini. Approval bukan consent/grant/install. Managed shipping pada engine lokal terisolasi dapat installable=true; integration runtime umum tetap blocked (ADR 0027). Revoke bukan uninstall. Cursor bukan identity; tidak ada pencarian merchant. Payment gateway internal Emisell, bukan distribusi aplikasi umum. Compatibility record historis dipertahankan.",
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "name": "afterId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil, tidak memberi akses runtime.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/List"
                }
              }
            }
          },
          "400": {
            "description": "Format/key/cursor invalid"
          },
          "401": {
            "description": "Sesi berakhir"
          },
          "403": {
            "description": "Origin/role tidak berwenang"
          },
          "404": {
            "description": "Target tidak ditemukan atau bukan milik organisasi; approval juga menolak merchant tidak dikenal."
          },
          "409": {
            "description": "Revision, duplicate assignment, idempotency payload atau release state conflict"
          },
          "503": {
            "description": "Layanan tidak tersedia"
          }
        }
      }
    },
    "/api/v1/admin/test-assignments/{id}": {
      "get": {
        "summary": "Detail assignment dan audit",
        "description": "ADR 0021/0026. Cookie dan Origin sesuai surface wajib. Developer hanya organisasinya; Admin membaca, administrator memutuskan dan memvalidasi merchant terdaftar. Sumber default integration; releaseKind=managed_shipping memilih release provider terkelola tanpa OAuth fiktif. Request baru/approval memverifikasi signature, checksum dan ownership. Snapshot/revision/idempotency/audit immutable; retry identik membaca state terkini. Approval bukan consent/grant/install. Managed shipping pada engine lokal terisolasi dapat installable=true; integration runtime umum tetap blocked (ADR 0027). Revoke bukan uninstall. Cursor bukan identity; tidak ada pencarian merchant. Payment gateway internal Emisell, bukan distribusi aplikasi umum. Compatibility record historis dipertahankan.",
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil, tidak memberi akses runtime.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detail"
                }
              }
            }
          },
          "400": {
            "description": "Format/key/cursor invalid"
          },
          "401": {
            "description": "Sesi berakhir"
          },
          "403": {
            "description": "Origin/role tidak berwenang"
          },
          "404": {
            "description": "Target tidak ditemukan atau bukan milik organisasi; approval juga menolak merchant tidak dikenal."
          },
          "409": {
            "description": "Revision, duplicate assignment, idempotency payload atau release state conflict"
          },
          "503": {
            "description": "Layanan tidak tersedia"
          }
        }
      }
    },
    "/api/v1/admin/test-assignments/{id}/status": {
      "post": {
        "summary": "Setujui, tolak atau cabut distribusi pengujian",
        "description": "ADR 0021/0026. Cookie dan Origin sesuai surface wajib. Developer hanya organisasinya; Admin membaca, administrator memutuskan dan memvalidasi merchant terdaftar. Sumber default integration; releaseKind=managed_shipping memilih release provider terkelola tanpa OAuth fiktif. Request baru/approval memverifikasi signature, checksum dan ownership. Snapshot/revision/idempotency/audit immutable; retry identik membaca state terkini. Approval bukan consent/grant/install. Managed shipping pada engine lokal terisolasi dapat installable=true; integration runtime umum tetap blocked (ADR 0027). Revoke bukan uninstall. Cursor bukan identity; tidak ada pencarian merchant. Payment gateway internal Emisell, bukan distribusi aplikasi umum. Compatibility record historis dipertahankan.",
