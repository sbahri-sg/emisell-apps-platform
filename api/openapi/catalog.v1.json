    "/api/v1/store/apps": {
      "get": {
        "operationId": "publicCatalog",
        "summary": "Daftar published dengan integrity verification, search, kategori dan pagination",
        "description": "API baca publik. Tidak menggunakan cookie; tidak ada instalasi atau endpoint privat. ADR 0022: authoring/distribusi baru hanya shipping/v1. Payment gateway checkout internal Emisell, bukan aplikasi umum. Record payment historis tetap terbaca; reject/suspend/revoke tersedia. Pengajuan/approval/sign/publish dan kesiapan app-client/Testing payment ditolak. Instalasi/RPC payment fixture tidak diubah.",
        "security": [],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "Literal substring nama/ringkasan (maksimal 120 byte)."
          },
          {
            "name": "capability",
            "in": "query",
            "schema": {
              "enum": [
                "",
                "payment/v1",
                "shipping/v1"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil; metadata katalog non-executable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "apps",
                    "total",
                    "page",
                    "pageSize"
                  ],
                  "properties": {
                    "apps": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PublicApp"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 500
                    },
                    "pageSize": {
                      "const": 20
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Input/policy tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sesi tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
