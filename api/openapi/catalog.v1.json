  "components": {
    "securitySchemes": {
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "emisell_admin_session"
      },
      "developerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "emisell_developer_session"
      }
    },
    "schemas": {
      "Manifest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "policy",
          "appId",
          "developerId",
          "version",
          "name",
          "summary",
          "description",
          "capability",
          "scopes",
          "runtime",
          "pricing",
          "installable",
          "sourceSha256"
        ],
        "properties": {
          "schema": {
            "enum": [
              "emisell.catalog/v2",
              "emisell.catalog/v1"
            ]
          },
          "policy": {
            "enum": [
              "catalog-metadata/v2",
              "catalog-metadata/v1"
            ]
          },
          "appId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "developerId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "capability": {
            "enum": [
              "payment/v1",
              "shipping/v1"
            ]
          },
          "scopes": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "runtime": {
            "const": "remote"
          },
          "pricing": {
            "const": "free"
          },
          "installable": {
            "const": false
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "accessScopes": {
            "$ref": "access-scopes.v1.json#/components/schemas/Declaration"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "capability": {
                  "const": "payment/v1"
                }
              }
            },
            "then": {
              "properties": {
                "scopes": {
                  "const": [
                    "orders.read",
                    "payments.read",
                    "payments.write"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "scopes": {
                  "const": [
                    "orders.read",
                    "shipping.read",
                    "shipping.write"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "schema": {
                  "const": "emisell.catalog/v2"
                }
              }
            },
            "then": {
              "required": [
                "accessScopes"
              ],
              "properties": {
                "policy": {
                  "const": "catalog-metadata/v2"
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "accessScopes"
                ]
              },
              "properties": {
                "policy": {
                  "const": "catalog-metadata/v1"
                }
              }
            }
          }
        ],
        "description": "v1: accessScopes tidak boleh ada; policy catalog-metadata/v1. v2: accessScopes wajib; policy catalog-metadata/v2. Scope arrays harus sorted. Keduanya non-executable, installable:false."
      },
      "Package": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "sha256",
          "keyId",
          "signature"
        ],
        "properties": {
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "keyId": {
            "type": "string",
            "pattern": "^catalog-[a-f0-9]{64}$"
          },
          "signature": {
            "type": "string",
            "contentEncoding": "base64"
          }
        }
      },
      "Release": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "submissionId",
          "package",
          "status",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "submissionId": {
            "type": "string"
          },
          "package": {
            "$ref": "#/components/schemas/Package"
          },
          "status": {
            "enum": [
              "signed",
              "published",
              "suspended"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Audit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "actorId",
          "action",
          "reason",
          "occurredAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "actorId": {
            "type": "string"
          },
          "action": {
            "enum": [
              "signed",
              "published",
              "suspended"
            ]
          },
          "reason": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "revision",
          "reason"
        ],
        "properties": {
          "status": {
            "enum": [
              "published",
              "suspended"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "PublicApp": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "appId",
          "developerId",
          "name",
          "summary",
          "description",
          "version",
          "capability",
          "scopes",
          "pricing",
          "installable"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "appId": {
            "type": "string"
          },
          "developerId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "capability": {
            "enum": [
              "payment/v1",
              "shipping/v1"
            ]
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pricing": {
            "const": "free"
          },
          "installable": {
            "const": false
          },
          "accessScopes": {
            "$ref": "access-scopes.v1.json#/components/schemas/Declaration"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      }
    }
  }
}
