{
  "openapi": "3.1.0",
  "info": {
    "title": "Emisell Catalog API",
    "version": "1.0.0",
    "description": "ADR 0009. Metadata-only free catalog, not executable app releases. String limits enforced in UTF-8 bytes in backend. Additive to portals.v1.json. No public cookie or tenant context. ADR 0022: authoring/distribusi baru hanya shipping/v1. Payment gateway checkout internal Emisell, bukan aplikasi umum. Record payment historis tetap terbaca; reject/suspend/revoke tersedia. Pengajuan/approval/sign/publish dan kesiapan app-client/Testing payment ditolak. Instalasi/RPC payment fixture tidak diubah."
  },
  "servers": [
    {
      "url": "http://localhost:8087"
    }
  ],
  "paths": {
    "/api/v1/admin/catalog": {
      "get": {
        "operationId": "adminCatalogList",
        "summary": "Daftar rilis katalog scoped",
        "description": "Origin atau Referer harus http://localhost:4317. Cookie audience admin; ownership/role enforced server-side. Mutations hanya Administrator, kecuali tidak tersedia untuk developer. ADR 0022: authoring/distribusi baru hanya shipping/v1. Payment gateway checkout internal Emisell, bukan aplikasi umum. Record payment historis tetap terbaca; reject/suspend/revoke tersedia. Pengajuan/approval/sign/publish dan kesiapan app-client/Testing payment ditolak. Instalasi/RPC payment fixture tidak diubah.",
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Berhasil; metadata katalog non-executable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "releases",
                    "limit"
                  ],
                  "properties": {
                    "releases": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Release"
                      }
                    },
                    "limit": {
                      "const": 200
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Input/policy tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sesi tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Surface/origin/role tidak diizinkan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Tidak ditemukan atau bukan milik organisasi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
