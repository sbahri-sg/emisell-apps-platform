  "components": {
    "securitySchemes": {
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "emisell_admin_session"
      },
      "developerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "emisell_developer_session"
      }
    },
    "schemas": {
      "Manifest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema": {
            "const": "emisell.managed-shipping-release/v1"
          },
          "policy": {
            "const": "managed-kurir-provider/v1"
          },
          "appId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "developerId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "draftRevision": {
            "type": "integer",
            "minimum": 1
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "capability": {
            "const": "shipping/v1"
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "const": "shipping.read"
            }
          },
          "binding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "engine": {
                "const": "api-kurir"
              },
              "providerCode": {
                "const": "emisell"
              }
            },
            "required": [
              "engine",
              "providerCode"
            ]
          },
          "pricing": {
            "const": "free"
          }
        },
        "required": [
          "schema",
          "policy",
          "appId",
          "developerId",
          "version",
          "name",
          "summary",
          "description",
          "draftRevision",
          "sourceSha256",
          "capability",
          "scopes",
          "binding",
          "pricing"
        ]
      },
      "Package": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "keyId": {
            "type": "string"
          },
          "signature": {
            "type": "string",
            "contentEncoding": "base64"
          }
        },
        "required": [
          "manifest",
          "sha256",
          "keyId",
          "signature"
        ]
      },
      "Release": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "sha256": {
            "type": "string"
          },
          "package": {
            "$ref": "#/components/schemas/Package"
          },
          "status": {
            "enum": [
              "submitted",
              "approved",
              "rejected",
              "signed",
              "suspended"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "organizationId",
          "manifest",
          "sha256",
          "status",
          "revision",
          "createdAt",
          "updatedAt"
        ]
      },
      "Readiness": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configurationReady": {
            "type": "boolean"
          },
          "requiredScopesReady": {
            "type": "boolean"
          },
          "installable": {
            "const": false
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "configurationReady",
          "requiredScopesReady",
          "installable",
          "blockers"
        ]
      },
      "Submit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "appId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "draftRevision": {
            "type": "integer",
            "minimum": 1
          },
          "binding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "engine": {
                "const": "api-kurir"
              },
              "providerCode": {
                "const": "emisell"
              }
            },
            "required": [
              "engine",
              "providerCode"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "appId",
          "draftRevision",
          "binding",
          "reason"
        ]
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "approved",
              "rejected",
              "signed",
              "suspended"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "status",
          "revision",
          "reason"
        ]
      },
      "List": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "releases": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/Release"
            }
          },
          "limit": {
            "const": 200
          }
        },
        "required": [
          "releases",
          "limit"
        ]
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "release": {
            "$ref": "#/components/schemas/Release"
          },
          "readiness": {
            "$ref": "#/components/schemas/Readiness"
          }
        },
        "required": [
          "release",
          "readiness"
        ]
      },
      "Detail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "release": {
            "$ref": "#/components/schemas/Release"
          },
          "readiness": {
            "$ref": "#/components/schemas/Readiness"
          },
          "history": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "actorId": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "occurredAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "id",
                "actorId",
                "action",
                "reason",
                "occurredAt"
              ]
            }
          },
          "trustedPublicKey": {
            "type": [
              "string",
              "null"
            ],
            "contentEncoding": "base64"
          }
        },
        "required": [
          "release",
          "readiness",
          "history",
          "trustedPublicKey"
        ]
      }
    }
  }
}
