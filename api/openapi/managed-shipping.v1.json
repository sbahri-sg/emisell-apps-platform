{
  "openapi": "3.1.0",
  "info": {
    "title": "Emisell Managed Shipping Release API",
    "version": "1.0.0",
    "description": "Release provider terkelola, bukan OAuth aplikasi eksternal. Draft snapshot, app/organisasi, versi, scope dan binding engine/provider immutable. Saat ini hanya api-kurir/emisell dengan shipping.read, tanpa endpoint/credential. Admin/reviewer meninjau, hanya administrator menandatangani atau suspend. Signature memakai key managed-shipping terpisah. Assignment tersedia lewat Testing (releaseKind=managed_shipping). Release bukan consent/grant. Lifecycle dan grant tersedia melalui komposisi engine lokal terisolasi (ADR 0027); assignment approved tetap diperlukan, tidak memilih checkout otomatis. Retry mengembalikan state terkini, bukan menghidupkan release suspended. Cookie/Origin sesuai surface wajib."
  },
  "servers": [
    {
      "url": "http://localhost:8087"
    }
  ],
  "paths": {
    "/api/v1/admin/managed-shipping-releases": {
      "get": {
        "summary": "Daftar release provider terkelola",
        "description": "Release provider terkelola, bukan OAuth aplikasi eksternal. Draft snapshot, app/organisasi, versi, scope dan binding engine/provider immutable. Saat ini hanya api-kurir/emisell dengan shipping.read, tanpa endpoint/credential. Admin/reviewer meninjau, hanya administrator menandatangani atau suspend. Signature memakai key managed-shipping terpisah. Assignment tersedia lewat Testing (releaseKind=managed_shipping). Release bukan consent/grant. Lifecycle dan grant tersedia melalui komposisi engine lokal terisolasi (ADR 0027); assignment approved tetap diperlukan, tidak memilih checkout otomatis. Retry mengembalikan state terkini, bukan menghidupkan release suspended. Cookie/Origin sesuai surface wajib.",
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "const": "http://localhost:4317"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil; bukan grant atau instalasi.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/List"
                }
              }
            }
          },
          "400": {
            "description": "Input/binding/scope tidak valid."
          },
          "401": {
            "description": "Sesi tidak valid."
          },
          "403": {
            "description": "Origin/role/ownership tidak diizinkan."
          },
          "404": {
            "description": "Tidak ditemukan atau organisasi lain."
          },
          "409": {
            "description": "Konflik revision, idempotency, versi atau state."
          },
          "503": {
            "description": "Signer/persistence belum tersedia."
          }
        }
      }
    },
    "/api/v1/admin/managed-shipping-releases/{id}": {
