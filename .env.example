NEXT_PUBLIC_SITE_URL=http://localhost:3003
NEXT_PUBLIC_APP_GATEWAY_URL=http://localhost:8081
# Server-only identity verification for the Admin documentation endpoint.
# Docker Compose overrides this with http://app-gateway:8080.
APP_GATEWAY_INTERNAL_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3003
NEXT_PUBLIC_APP_GATEWAY_TOKEN=emisell-local-dev-token
NEXT_PUBLIC_ORGANIZATION_ID=01995f72-0000-7000-8000-000000000001
NEXT_PUBLIC_ENABLE_DEVELOPMENT_LOGIN=true
NEXT_PUBLIC_AUTH_CSRF_COOKIE_NAME=emisell_csrf
NEXT_PUBLIC_MERCHANT_CSRF_COOKIE_NAME=emisell_merchant_csrf
NEXT_PUBLIC_SANDBOX_MERCHANT_ID=cmmerchantdemo000000000001
# Comma-separated Vite development hosts. Production standalone does not use it.
VITE_ALLOWED_HOSTS=apps-platform.emisell.com

# Docker Compose host ports
FRONTEND_PORT=3003
GATEWAY_PORT=8081
API_DOCS_PORT=8082
POSTGRES_PORT=55433

# Local development identity
DEVELOPMENT_BEARER_TOKEN=emisell-local-dev-token
DEVELOPMENT_ORGANIZATION_ID=01995f72-0000-7000-8000-000000000001
DEVELOPMENT_USER_ID=01995f72-0000-7000-8000-000000000002
DEVELOPMENT_ROLE=owner
DEVELOPMENT_EMAIL=developer@local.emisell.test
DEVELOPMENT_DISPLAY_NAME=Local Developer
DEVELOPMENT_PLATFORM_OPERATOR=false
AUTH_SESSION_TTL=12h
AUTH_SESSION_IDLE_TTL=2h
AUTH_SESSION_COOKIE_NAME=emisell_session
AUTH_CSRF_COOKIE_NAME=emisell_csrf
MERCHANT_SESSION_COOKIE_NAME=emisell_merchant_session
MERCHANT_CSRF_COOKIE_NAME=emisell_merchant_csrf
PUBLIC_GATEWAY_URL=http://localhost:8081
EMISELL_BACKEND_SESSION_GRANT_TTL=2m
EMISELL_BACKEND_DEVELOPMENT_TOKEN=emisell-backend-local-token
DEVELOPER_INVITATION_TTL=48h
SECRET_ENCRYPTION_KEY_BASE64=r8PQPmYOmajyNIx3Gn4bEISAPze1pvrCs8vB/WOjjjc=
SECRET_ENCRYPTION_KEY_VERSION=1
# Operator-managed installation/extension credentials. Review docs/managed-extensions.md before enabling.
EXTENSION_CONNECTIONS_ENABLED=false

# Short-lived OAuth grants and bounded webhook delivery worker
OAUTH_CODE_TTL=5m
OAUTH_ACCESS_TOKEN_TTL=1h
WEBHOOK_POLL_INTERVAL=1s
WEBHOOK_REQUEST_TIMEOUT=8s
WEBHOOK_BATCH_SIZE=25
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BASE_RETRY=5s
WEBHOOK_MAX_RETRY=15m

# Production JWT verification (required only when APP_ENV=production)
# AUTH_JWT_ISSUER=https://identity.example.com
# AUTH_JWT_AUDIENCE=emisell-app-platform
# AUTH_JWT_KEY_ID=production-key-1
# AUTH_JWT_PUBLIC_KEY_BASE64=<base64-encoded RSA public key PEM>
# AUTH_JWT_CLOCK_SKEW=30s

# Production Emisell Backend store-session bridge (server-side only)
# EMISELL_BACKEND_JWT_ISSUER=https://api.emisell.com
# EMISELL_BACKEND_JWT_AUDIENCE=emisell-app-platform-store-bridge
# EMISELL_BACKEND_JWT_KEY_ID=store-bridge-key-1
# EMISELL_BACKEND_JWT_PUBLIC_KEY_BASE64=<base64-encoded RSA public key PEM>
# EMISELL_BACKEND_JWT_CLOCK_SKEW=30s

# Optional browser login via any OpenID Connect provider. Keep secrets server-side.
AUTH_OIDC_ENABLED=false
# AUTH_OIDC_ISSUER=https://identity.example.com
# AUTH_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.com/oauth2/authorize
# AUTH_OIDC_TOKEN_ENDPOINT=https://identity.example.com/oauth2/token
# AUTH_OIDC_CLIENT_ID=emisell-app-platform
# AUTH_OIDC_CLIENT_SECRET=<server-side-secret>
# AUTH_OIDC_REDIRECT_URL=https://gateway.example.com/auth/callback
# AUTH_OIDC_KEY_ID=identity-key-1
# AUTH_OIDC_PUBLIC_KEY_BASE64=<base64-encoded RSA public key PEM>
# AUTH_OIDC_SCOPES=openid,profile,email
# AUTH_OIDC_CLOCK_SKEW=30s
# AUTH_OIDC_LOGIN_TTL=5m

# Local PostgreSQL only; do not reuse these values in production
POSTGRES_DB=emisell_app_platform
POSTGRES_USER=emisell
POSTGRES_PASSWORD=emisell-dev
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT=5s
# Outbound read_products pilot (not the inbound merchant-session JWT).
# Keep disabled until api-service, verification keys and test-merchant allowlist are configured.
# For Docker, mount a private key using a local compose override and use the container path.
EMISELL_RESOURCE_ENABLED=false
EMISELL_RESOURCE_BASE_URL=
EMISELL_RESOURCE_KEY_ID=
EMISELL_RESOURCE_PRIVATE_KEY_FILE=
# Optional, isolated development installation pilot. Not public scope availability.
EMISELL_RESOURCE_TEST_MERCHANT_IDS=
DEVELOPMENT_LOOPBACK_APP_HTTP=false
APP_BILLING_ENABLED=false
# Live app fees require production auth and a separately tested Emisell invoice adapter.
APP_BILLING_LIVE_ENABLED=false

# Internal App Platform -> API Kurir rate calculation bridge. Default off.
# API Kurir chooses merchant services/provider/credential and owns cache + quota.
# Never expose API_KURIR_SERVICE_KEY through NEXT_PUBLIC_* or frontend code.
API_KURIR_RATES_ENABLED=false
API_KURIR_BASE_URL=
API_KURIR_SERVICE_KEY=
API_KURIR_RATES_TIMEOUT=5s
