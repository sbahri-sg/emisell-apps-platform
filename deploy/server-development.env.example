# Non-secret public-origin settings for the temporary development deployment.
# Copy to the ignored root .env on the server. Do not add secrets to this file.
NEXT_PUBLIC_SITE_URL=https://apps-platform.emisell.com
NEXT_PUBLIC_APP_GATEWAY_URL=
# Require the browser session created by Development Login. Do not fall back
# to the local bearer bootstrap after logout on a shared server.
NEXT_PUBLIC_APP_GATEWAY_TOKEN=
NEXT_PUBLIC_ORGANIZATION_ID=
VITE_ALLOWED_HOSTS=apps-platform.emisell.com
FRONTEND_URL=https://apps-platform.emisell.com
PUBLIC_GATEWAY_URL=https://apps-platform.emisell.com
CORS_ALLOWED_ORIGINS=https://apps-platform.emisell.com
