# Copy to deploy/production.env. That destination is ignored by Git.
# Terminate TLS in a reverse proxy and route these origins to the loopback ports.
FRONTEND_URL=https://apps.example.com
PUBLIC_GATEWAY_URL=https://gateway.apps.example.com
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3003
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8081

# Use a URL-safe password or percent-encode it inside DATABASE_URL. The host is
# the Compose service name "postgres", not localhost.
POSTGRES_DB=emisell_app_platform
POSTGRES_USER=emisell
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgres://emisell:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/emisell_app_platform?sslmode=disable
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2

# Generate independently with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
SECRET_ENCRYPTION_KEY_VERSION=1

# Public verification key for developer/API bearer tokens. Private signing keys
# stay in the identity issuer and must never be copied into App Platform.
AUTH_JWT_ISSUER=https://identity.example.com
AUTH_JWT_AUDIENCE=emisell-app-platform
AUTH_JWT_KEY_ID=developer-key-2026-01
AUTH_JWT_PUBLIC_KEY_BASE64=REPLACE_WITH_BASE64_ENCODED_RSA_PUBLIC_KEY_PEM

# Public verification key for merchant session assertions from Emisell Backend.
EMISELL_BACKEND_JWT_ISSUER=https://api.example.com
EMISELL_BACKEND_JWT_AUDIENCE=emisell-app-platform
EMISELL_BACKEND_JWT_KEY_ID=emisell-backend-key-2026-01
EMISELL_BACKEND_JWT_PUBLIC_KEY_BASE64=REPLACE_WITH_BASE64_ENCODED_RSA_PUBLIC_KEY_PEM

# UUID of the internal Emisell organization used when creating Admin accounts.
ADMIN_PLATFORM_ORGANIZATION_ID=REPLACE_WITH_PLATFORM_ORGANIZATION_UUID

# MVP feature gates remain off until their counterpart is integrated and tested.
AUTH_OIDC_ENABLED=false
EXTENSION_CONNECTIONS_ENABLED=false
APP_BILLING_ENABLED=false
API_KURIR_RATES_ENABLED=false
API_KURIR_BASE_URL=
API_KURIR_SERVICE_KEY=
