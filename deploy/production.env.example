# Copy to deploy/production.env (ignored); domains only, no https:// or slash.
DASHBOARD_DOMAIN=dashboard.example.com
STORE_DOMAIN=apps.example.com
ACME_EMAIL=ops@example.com
# Generate a random URL-safe password, minimum 16 characters (letters/digits recommended).
POSTGRES_PASSWORD=
# Persistent Apps Platform encryption key; never expose to frontend or regenerate per deploy.
# 32 random bytes encoded as base64 without padding; see docs/application-credentials.md.
EMISELL_APP_CREDENTIAL_KEY=
# Existing seller Dashboard origin for developer merchant login.
EMISELL_SELLER_ORIGIN=
